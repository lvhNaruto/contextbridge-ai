# ContextBridge configuration — copy to .env.local (never commit real values).
# Shared by the FastAPI backend (api/) and the preserved prototype (app.py).

# --- Google Cloud / Vertex AI (required for real analysis; omit for fixtures-only mock mode) ---
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_REGION=us-central1
VERTEX_MODEL_ID=gemini-2.5-flash

# --- Storage (optional: persist uploaded videos in GCS; omit for local disk) ---
CONTEXTBRIDGE_BUCKET=your-gcs-bucket-name

# --- Local persistence ---
CONTEXTBRIDGE_DB_PATH=contextbridge.db

# --- API only: allowed web origin for CORS (Phase 4 sets this to the deployed web URL) ---
WEB_ORIGIN=http://localhost:3000
